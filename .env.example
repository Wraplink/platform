# Wraplink platform environment template
# Copy this file to .env and generate secrets using scripts/init-env.sh.
# Never commit .env or paste its secret values into issue reports.
# Values below are local-development defaults; review before production use.

# PostgreSQL database name, login role, and password.
POSTGRES_DB=wraplink
POSTGRES_USER=wraplink
# Required secret. Replace CHANGE_ME with a strong random password.
POSTGRES_PASSWORD=CHANGE_ME

# Backend JWT signing secret; must be long, random, and kept private.
JWT_SECRET=CHANGE_ME
# Shared secret used to authenticate network usage ingestion.
NETWORK_USAGE_INGEST_KEY=CHANGE_ME
# Shared secret for network-control synchronization.
NETWORK_CONTROL_SYNC_KEY=CHANGE_ME
# Credentials used by DNS Control API clients and edge agents.
DNS_CONTROL_API_TOKEN=CHANGE_ME
DNS_CONTROL_AGENT_TOKEN=CHANGE_ME
# Optional development payment-settlement key; leave blank unless enabled.
PAYMENTS_DEV_SETTLEMENT_KEY=

# DNS Control listener and comma-separated upstream DNS servers.
# :53 binds DNS to all interfaces in the container.
DNS_LISTEN=:53
DNS_UPSTREAM=1.1.1.1:53,8.8.8.8:53
# DNS Control HTTP API bind address inside the container.
API_LISTEN=:8080

# Public platform hostname and host-side published service ports.
# Use an actual DNS name for PLATFORM_HOST in production.
PLATFORM_HOST=localhost
WEB_PORT=3000
BACKEND_PORT=7080
DNS_API_PORT=8080
DNS_PORT=53

# DNS node identity, deployment region, and externally reachable IPv4 address.
# NODE_PUBLIC_IP must reflect the address clients can actually reach.
NODE_ID=dns-local-01
NODE_REGION=local
NODE_PUBLIC_IP=127.0.0.1

# Browser-facing web origin (scheme, host, and optional port).
FRONTEND_URL=http://localhost:3000
# Application runtime environment: development or production.
APP_ENV=development
# Set true when serving authenticated sessions over HTTPS.
SECURE_COOKIES=false
# Optional shared cookie domain; blank uses host-only cookies.
COOKIE_DOMAIN=
# Optional trusted reverse-proxy addresses/ranges; leave blank unless configured.
BACKEND_TRUSTED_PROXIES=

# Enable optional edge service only after configuring its network settings.
EDGE_ENABLED=false
# Unique edge identifier, region, and advertised/reachable address list.
EDGE_ID=edge-local-01
EDGE_REGION=local
EDGE_ADDRESSES=127.0.0.1
# Optional public IP addresses reserved for full-route traffic.
EDGE_ROUTE_PUBLIC_IPS=
# Enable SNI routing on this edge when its listener is configured.
EDGE_SNI_ENABLED=false
# Maximum advertised capacity for full-route and SNI traffic.
EDGE_ROUTE_CAPACITY=0
EDGE_SNI_CAPACITY=100
# Edge SNI listener bind address; loopback is suitable only for local tests.
EDGE_SNI_LISTEN=127.0.0.1:8443

# Optional outbound SOCKS5 proxy settings for scripts that support them.
# These settings do NOT automatically configure the Docker daemon or BuildKit.
PROXY_ENABLED=false
# Set to your reachable SOCKS5 server IP/hostname (example shown).
SOCKS5_PROXY_HOST=192.168.10.204
# Set to your SOCKS5 listener port; leave blank when proxy is disabled.
SOCKS5_PROXY_PORT=10810
