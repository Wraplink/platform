# Copy to .env; generate secrets with scripts/init-env.sh. NEVER commit .env.
POSTGRES_DB=wraplink
POSTGRES_USER=wraplink
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
NETWORK_USAGE_INGEST_KEY=CHANGE_ME
NETWORK_CONTROL_SYNC_KEY=CHANGE_ME
DNS_CONTROL_API_TOKEN=CHANGE_ME
DNS_CONTROL_AGENT_TOKEN=CHANGE_ME
PAYMENTS_DEV_SETTLEMENT_KEY=
DNS_LISTEN=:53
DNS_UPSTREAM=1.1.1.1:53,8.8.8.8:53
API_LISTEN=:8080
PLATFORM_HOST=localhost
WEB_PORT=3000
BACKEND_PORT=7080
DNS_API_PORT=8080
DNS_PORT=53
NODE_ID=dns-local-01
NODE_REGION=local
NODE_PUBLIC_IP=127.0.0.1
FRONTEND_URL=http://localhost:3000
APP_ENV=development
SECURE_COOKIES=false
COOKIE_DOMAIN=
BACKEND_TRUSTED_PROXIES=
EDGE_ENABLED=false
EDGE_ID=edge-local-01
EDGE_REGION=local
EDGE_ADDRESSES=127.0.0.1
EDGE_ROUTE_PUBLIC_IPS=
EDGE_SNI_ENABLED=false
EDGE_ROUTE_CAPACITY=0
EDGE_SNI_CAPACITY=100
EDGE_SNI_LISTEN=127.0.0.1:8443

# Optional outbound SOCKS5 proxy (port must be provided by operator)
PROXY_ENABLED=false
